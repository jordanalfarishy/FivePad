<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pengingat tugas (FR-2.11). Dijadwalkan lokal, tanpa layanan push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarm hilang saat reboot, jadi pengingat perlu dijadwalkan ulang. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Tanpa ini, alarm sejak Android 12 dijadwalkan dengan jendela satu jam —
      pengingat tugas bisa berbunyi jauh setelah waktunya. Izin ini TIDAK
      diberikan otomatis: pengguna mengaktifkannya lewat "Alarm & pengingat" di
      pengaturan sistem, dan kode tetap turun ke alarm longgar bila tidak.
      USE_EXACT_ALARM sengaja dihindari — itu diperuntukkan aplikasi yang inti
      fungsinya jam atau kalender, sementara inti FivePad adalah catatan.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".FivePadApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FivePad">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FivePad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
