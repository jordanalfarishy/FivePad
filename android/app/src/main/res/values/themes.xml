<resources>
    <!--
      Dua tema, dipilih di dalam aplikasi lewat setTheme() sebelum super.onCreate().
      Yang diatur hanya latar jendela: seluruh warna lain datang dari Compose.
      Tanpa ini, pengguna mode terang melihat kilatan gelap di antara layar
      pembuka dan bingkai pertama.
    -->
    <style name="Theme.FivePad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <style name="Theme.FivePad.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background_light</item>
    </style>

    <!--
      Tema pembuka. Android 12+ menampilkan splash apa pun yang kita mau atau
      tidak — tanpa ini ia memakai ikon peluncur bawaan, yang sebelumnya berarti
      robot Android. postSplashScreenTheme mengembalikan tema aplikasi begitu
      splash selesai, sehingga tema pembuka tidak ikut terbawa ke layar utama.
    -->
    <style name="Theme.FivePad.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FivePad</item>
    </style>
</resources>
